#!name=GitHub Star Push Time
#!desc=在 GitHub App 已加星标仓库列表的语言后显示最近推送时间
#!author=瀬戸 明日葉
#!category=GitHub

[Body Rewrite]
http-request-jq ^https?://api\.github\.com/graphql(?:\?.*)?$ 'if (.variables.name | type) == "string" then .variables.name |= sub(" · (刚刚|[0-9]+分钟前|[0-9]+小时前|[0-9]+天前|[0-9]{4}-[0-9]{2}-[0-9]{2})$"; "") else . end'
http-request-jq ^https?://api\.github\.com/graphql(?:\?.*)?$ 'if .operationName == "StarredRepositoriesForUser" and (.query | type) == "string" and (.query | contains("fragment RepositoryListItemFragment on Repository {")) and ((.query | contains("pushedAt")) | not) then .query |= sub("fragment RepositoryListItemFragment on Repository \\{"; "fragment RepositoryListItemFragment on Repository { pushedAt updatedAt") else . end'
http-response-jq ^https?://api\.github\.com/graphql(?:\?.*)?$ 'if (.data.user.starredRepositories.nodes | type) != "array" then . else .data.user.starredRepositories.nodes |= map(if .__typename != "Repository" or (.pushedAt | type) != "string" or (.primaryLanguage | type) != "object" or (.primaryLanguage.name | type) != "string" or ((.primaryLanguage.name | test(" · (刚刚|[0-9]+分钟前|[0-9]+小时前|[0-9]+天前|[0-9]{4}-[0-9]{2}-[0-9]{2})$"))) then . else ((.pushedAt | try fromdateiso8601 catch null)) as $t | if $t == null then . else (now - $t) as $d | (if $d < 60 then "刚刚" elif $d < 3600 then ((($d / 60) | floor | tostring) + "分钟前") elif $d < 86400 then ((($d / 3600) | floor | tostring) + "小时前") elif $d < 2592000 then ((($d / 86400) | floor | tostring) + "天前") else ($t | strftime("%Y-%m-%d")) end) as $label | .primaryLanguage.name = (.primaryLanguage.name + " · " + $label) end end) end'

[MITM]
hostname = api.github.com